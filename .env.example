# ==============================================================================
# 🎖️ ระบบเสนอขอรับสิทธิเงินค่าสินไหมทดแทน กองทัพบก (RTA Claim Management System)
# ไฟล์แม่แบบ Environment Variables (.env.example)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามการใช้งานจริง: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. การทำงานของเซิร์ฟเวอร์ (Server & Next.js Runtime)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
APP_URL=http://sinmai.rta.mi.th

# ------------------------------------------------------------------------------
# 2. การเชื่อมต่อฐานข้อมูล PostgreSQL (Database Credentials)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rta_sinmai
DB_USER=rta_admin
DB_PASSWORD=RtaSinmai@2026!
DATABASE_URL=postgresql://rta_admin:RtaSinmai@2026!@localhost:5432/rta_sinmai

# ------------------------------------------------------------------------------
# 3. การแจ้งเตือนผ่าน Telegram Bot API (Telegram Notification)
# ------------------------------------------------------------------------------
# หากต้องการเปิดใช้งาน ให้ใส่ Token ที่ได้จาก @BotFather และ Chat ID กลุ่ม/ช่องทาง
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. ความปลอดภัยและการเข้ารหัส (Security & Authentication)
# ------------------------------------------------------------------------------
SESSION_SECRET=rta_sinmai_jwt_secret_token_key_secure_2026
NEXTAUTH_SECRET=rta_sinmai_nextauth_secret_key_2026

